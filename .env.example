# Environment Mode
ENV=development

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5436

# Database URLs for Microservices (Host Connection)
AUTH_DB_URL=postgres://postgres:postgres@localhost:5436/streamlite_auth?sslmode=disable
CATALOG_DB_URL=postgres://postgres:postgres@localhost:5436/streamlite_catalog?sslmode=disable
TRANSCODER_DB_URL=postgres://postgres:postgres@localhost:5436/streamlite_transcoder?sslmode=disable
WATCH_DB_URL=postgres://postgres:postgres@localhost:5436/streamlite_watch?sslmode=disable
RECOMMENDATION_DB_URL=postgres://postgres:postgres@localhost:5436/streamlite_recommendation?sslmode=disable

# Redis Configuration
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381/0

# Redpanda (Kafka Wire-Compatible) Configuration
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
KAFKA_BROKERS=localhost:9092

# SeaweedFS (Local AWS S3-Compatible) Configuration
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=streamlite_dev_key
S3_SECRET_KEY=streamlite_dev_secret
S3_REGION=us-east-1
S3_RAW_BUCKET=streamlite-raw
S3_VOD_BUCKET=streamlite-vod

# Mailpit Configuration
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
